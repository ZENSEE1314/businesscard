# Core
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Konnect"
NODE_ENV="development"
PORT="3000"

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth — sign JWT access tokens. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Object storage (S3-compatible: Railway bucket, S3, R2, MinIO)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
STORAGE_DRIVER="local"

# Initial admin (created on first run/seed if no admin exists)
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="change-me-strong-password"

# Email (optional; blank = console log in dev)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="BridgeX <no-reply@example.com>"

# ---------------------------------------------------------------------------
# AI profile generation (Ollama on Railway private networking)
# Leave OLLAMA_BASE_URL empty to disable AI gracefully — the app works fine.
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL="http://ollama-ai.railway.internal:11434"
OLLAMA_MODEL="kimi-k3:cloud"
# Only needed if your Ollama service requires bearer auth (cloud models need
# the Ollama service itself to be signed in — see DEPLOYMENT.md).
OLLAMA_API_KEY=""
OLLAMA_TIMEOUT_MS="30000"
AI_PROFILE_GENERATION_ENABLED="true"

# Timezone used for check-in dates, login streaks and membership days
DAILY_CHECK_IN_TIMEZONE="Asia/Jakarta"
